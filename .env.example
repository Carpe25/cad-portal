# =============================================================================
# CAD Portal — environment variables
# Copy to .env and fill in values. Never commit .env.
# =============================================================================

# --- Self-hosted Postgres (Docker) ---
POSTGRES_USER=carpediam
POSTGRES_PASSWORD=change-me-set-a-strong-password
POSTGRES_DB=cad_portal

# App database URL
# Local dev (postgres container on host port 5434):
DATABASE_URL=postgresql://carpediam:change-me-set-a-strong-password@localhost:5434/cad_portal
# If your password has special characters, URL-encode them (e.g. / → %2F).

# One-time Neon source for ./scripts/neon-migrate.sh (remove after migration)
NEON_DATABASE_URL=

# --- Auth ---
SESSION_SECRET=generate-a-long-random-string-here

# --- Linode Object Storage ---
LINODE_OBJECT_STORAGE_ACCESS_KEY=
LINODE_OBJECT_STORAGE_SECRET_KEY=
LINODE_OBJECT_STORAGE_REGION=us-east-1
LINODE_OBJECT_STORAGE_BUCKET=cad-portal
LINODE_OBJECT_STORAGE_ENDPOINT=

# --- Google Drive (optional) ---
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_DELEGATE_EMAIL=
GOOGLE_DRIVE_PARENT_FOLDER_ID=
GOOGLE_DRIVE_TARGET_EMAIL=

# --- CometChat (optional) ---
NEXT_PUBLIC_COMETCHAT_APP_ID=
NEXT_PUBLIC_COMETCHAT_REGION=
NEXT_PUBLIC_COMETCHAT_AUTH_KEY=

# --- Cloudflare AI PDF parse (optional) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
